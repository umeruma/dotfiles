# Included by ~/.gitconfig only inside this repo (and its worktrees, whose
# git dirs live under .git/worktrees). Relative, so each worktree runs its
# own copy of the hooks. Filters are referenced from .gitattributes.
[core]
	hooksPath = .githooks
[filter "home"]
	clean = sed \"s|$HOME|\\$HOME|g\"
	smudge = sed \"s|\\\\\\$HOME|$HOME|g\"
