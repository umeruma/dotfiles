#!/bin/sh
# Stops a commit that leaks a secret. repo.gitconfig (included by
# ~/.gitconfig) sets core.hooksPath=.githooks; gitleaks comes from [tools] in mise.toml.
set -eu

# Tools that stage hunks (Orca, gitsigns, lazygit) apply their own diff to the
# index and skip the claude-settings clean filter, so drop `model` here too.
f=home/.claude/settings.json
if git show ":$f" 2>/dev/null | grep -q '"model"'; then
  blob=$(git show ":$f" | jq 'del(.model)' | git hash-object -w --stdin)
  git update-index --cacheinfo "100644,$blob,$f"
fi

if ! command -v mise >/dev/null 2>&1; then
  echo "pre-commit: mise not found; skipping gitleaks" >&2
  exit 0
fi

if ! mise exec -- gitleaks git --staged --redact --no-banner --log-level warn .; then
  echo "pre-commit: gitleaks found a secret in the staged changes; remove it before committing" >&2
  echo "  (false positive: add its fingerprint to .gitleaksignore)" >&2
  exit 1
fi
