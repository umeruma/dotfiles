// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "diff_view_style": "split",
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "tree_view": true
  },
  "base_keymap": "VSCode",
  "disable_ai": true,
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "bell": "system",
    "env": {
      "FIG_NEW_SESSION": "\"1\""
    },
    "font_size": 15.0,
    "font_family": "Moralerspace Neon",
    "font_fallbacks": [
      "monospace"
    ],
    "line_height": {
      "custom": 1.2
    }
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "preview_tabs": {
    "enabled": false
  },
  "tab_bar": {
    "show": false
  },
  "tabs": {
    "close_position": "left"
  },
  "sticky_scroll": {
    "enabled": true
  },
  "minimap": {
    "show": "never"
  },
  "buffer_font_family": "Moralerspace Argon",
  "file_types": {
    "html": [
      "*.html"
    ],
    "plaintext": [
      "config"
    ],
    "stylus": [
      "*.styl"
    ]
  },
  "linked_edits": true,
  "show_whitespaces": "boundary",
  "show_edit_predictions": true,
  "preferred_line_length": 103,
  "soft_wrap": "editor_width",
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
}
