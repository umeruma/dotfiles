# .editorconfig の end_of_line = lf に合わせ、作業ツリーも LF で統一する。
# core.autocrlf=true の環境で改行だけの差分（gitsigns の青いライン）が出るのを防ぐ。
* text=auto eol=lf

# Orca などが絶対パスで書き戻すファイル。git には $HOME で保存する（filter は mise run deploy で登録）。
home/.cursor/hooks.json filter=home

# Claude Code が /model のたびに書き戻す `model` は git に入れない（filter は mise run deploy で登録）。
# サイズが変わると git status には M が出るが diff は空で、commit にも乗らない。`git add` で消える。
home/.claude/settings.json filter=claude-settings
