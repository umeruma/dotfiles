[user]
	name = umeruma
	email = dev@umeru.ma

[pull]
	rebase = false
	ff = false

# cendre hard for delta — https://cendretheme.com / extras/delta
[include]
	path = ~/.config/delta/cendre.gitconfig

# Work identity: repos under ~/Codes_DL pick up ~/Codes_DL/.gitconfig
# (not tracked here). Machine-local settings (safe.directory, editor,
# extra includeIf for other drives) go in ~/.gitconfig.local.
[includeIf "gitdir/i:~/Codes_DL/"]
	path = ~/Codes_DL/.gitconfig
# This repo's hooks and filters (repo.gitconfig), for every worktree too
[includeIf "gitdir/i:~/Codes/dotfiles/"]
	path = ~/Codes/dotfiles/repo.gitconfig
[include]
	path = ~/.gitconfig.local

# Git Worktree Manager Settings — same as home/.gitconfig (no remover: Windows has no `trash` CLI)
# https://github.com/k1LoW/git-wt?tab=readme-ov-file#configuration
[wt]
	basedir = ../{gitroot}-wt
	copyuntracked = true
	copyignored = false
	copymodified = true
