# Terminal file manager (https://yazi-rs.github.io).
# Colours: home/.config/yazi/flavors/cendre.yazi. theme.toml is generated
# here so file icons reuse Neovim's two-cell glyphs (nvim/file-icons.toml).
{ config, lib, pkgs, ... }:
let
  icons = builtins.fromTOML (builtins.readFile ../../../home/.config/nvim/file-icons.toml);
  glyph = cat: icons.glyphs.${cat};
  # cendre muted. nvim's #3c3531 vanishes on the hovered row (#201b19), and
  # yazi has no hovered condition for name/extension rules.
  rule = key: name: text: "  { ${key} = ${builtins.toJSON name}, text = ${builtins.toJSON text}, fg = \"#73665b\" },";
  capitalize = s: lib.toUpper (builtins.substring 0 1 s) + builtins.substring 1 (-1) s;
  theme = pkgs.writeText "yazi-theme.toml" ''
    # GENERATED by `mise run switch` from nix/home-manager/tools/yazi.nix.
    # Do not edit: icons come from nvim/file-icons.toml, colours from
    # flavors/cendre.yazi.

    [flavor]
    dark = "cendre"
    light = "cendre"

    [icon]
    globs = []
    dirs = []
    files = [
    ${lib.concatLines (
      lib.concatLists (
        lib.mapAttrsToList (n: c: [
          (rule "name" n (glyph c))
          (rule "name" (capitalize n) (glyph c))
        ]) icons.files
      )
    )}]
    exts = [
    ${lib.concatLines (lib.mapAttrsToList (n: c: rule "name" n (glyph c)) icons.extensions)}]
    conds = [
    ${rule "if" "dir & hovered" icons.glyphs.folder_open}
    ${rule "if" "dir" (glyph icons.default_folder)}
    ${rule "if" "!dir" (glyph icons.default_file)}
    ]
  '';
in
{
  home.packages = [ pkgs.yazi ];

  home.activation.yaziTheme = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    if ! /usr/bin/cmp -s ${theme} "${config.my.repo}/home/.config/yazi/theme.toml"; then
      run /usr/bin/install -m 644 ${theme} "${config.my.repo}/home/.config/yazi/theme.toml"
    fi
  '';
}
